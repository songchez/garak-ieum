{
  "name": "garak-ieum",
  "version": "0.1.4",
  "description": "가락이음 — 로컬 음악 작업실",
  "author": "songchez",
  "main": "dist-desktop/main.js",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-only",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "pnpm licenses:prepare && vite --host 0.0.0.0",
    "build": "pnpm licenses:prepare && tsc -b && vite build",
    "licenses:prepare": "node scripts/prepare-licenses.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "mcp:build": "tsc -p tsconfig.mcp.json",
    "mcp:start": "node dist-mcp/mcp/server.js",
    "mcp:token": "node dist-mcp/mcp/token.js",
    "desktop:compile": "tsc -p tsconfig.desktop.json",
    "native:build": "node scripts/build-native-audio.mjs",
    "native:test": "pnpm run desktop:compile && node scripts/native-test.mjs",
    "desktop:prepare": "pnpm run native:build && pnpm run build && pnpm run mcp:build && pnpm run desktop:compile",
    "desktop:dev": "pnpm run desktop:prepare && install-electron && electron .",
    "desktop:launcher": "node scripts/build-mcp-launcher.mjs",
    "desktop:pack": "pnpm run desktop:launcher && pnpm run desktop:prepare && electron-builder --dir --publish never",
    "desktop:build": "pnpm run desktop:launcher --require-windows && pnpm run desktop:prepare && electron-builder --win nsis --x64 --publish never",
    "desktop:build:mac": "node scripts/desktop-build-macos.mjs",
    "desktop:install:mac:test": "node scripts/desktop-install-macos.mjs",
    "desktop:test": "node scripts/desktop-smoke.mjs",
    "desktop:source": "node scripts/desktop-source.mjs",
    "release:prepare": "node scripts/release-config.mjs prepare",
    "release:check": "node scripts/release-config.mjs check",
    "release:test": "node --test scripts/release-tests.mjs",
    "test": "vitest run",
    "wavetable:schema": "node src/devices/wavetable-synth/generate-schema.mjs --check",
    "wavetable:fixtures": "node src/devices/wavetable-synth/generate-fixtures.mjs",
    "wavetable:build": "cmake -S native/devices/wavetable-synth -B build/native/wavetable-synth -DCMAKE_BUILD_TYPE=Release && cmake --build build/native/wavetable-synth --config Release",
    "wavetable:test": "ctest --test-dir build/native/wavetable-synth -C Release --output-on-failure",
    "wavetable:smoke": "node scripts/wavetable-smoke.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "lucide-react": "1.66.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "ws": "8.22.1"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "fake-indexeddb": "6.2.7",
    "playwright": "1.64.1",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
