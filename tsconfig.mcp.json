{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "lib": ["ES2022", "DOM"],
    "noEmit": false,
    "allowImportingTsExtensions": false,
    "rootDir": ".",
    "outDir": "dist-mcp",
    "declaration": false,
    "sourceMap": false
  },
  "include": ["mcp/**/*.ts", "src/automation/protocol.ts", "src/core/commands.ts"],
  "exclude": ["**/*.test.ts", "node_modules", "dist", "dist-mcp"]
}
