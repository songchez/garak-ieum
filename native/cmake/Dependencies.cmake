# The corresponding-source release packager reads this same archive manifest.
set(GARAK_DEPENDENCY_CACHE "${CMAKE_BINARY_DIR}/archives" CACHE PATH "Verified native source archive cache")
set(GARAK_DEPENDENCY_SOURCES "${CMAKE_BINARY_DIR}/dependencies" CACHE PATH "Extracted native dependency sources")
file(READ "${CMAKE_CURRENT_LIST_DIR}/../dependencies.lock.json" GARAK_DEPENDENCY_LOCK)

function(garak_source_dependency id output)
  string(JSON count LENGTH "${GARAK_DEPENDENCY_LOCK}" dependencies)
  math(EXPR last "${count} - 1")
  set(found FALSE)
  foreach(i RANGE 0 ${last})
    string(JSON current GET "${GARAK_DEPENDENCY_LOCK}" dependencies ${i} id)
    if(NOT current STREQUAL id)
      continue()
    endif()
    foreach(key url archive sha256 directory archiveRoot)
      string(JSON ${key} GET "${GARAK_DEPENDENCY_LOCK}" dependencies ${i} ${key})
    endforeach()
    file(MAKE_DIRECTORY "${GARAK_DEPENDENCY_CACHE}")
    set(archive_path "${GARAK_DEPENDENCY_CACHE}/${archive}")
    if(EXISTS "${archive_path}")
      file(SHA256 "${archive_path}" actual_hash)
      if(NOT actual_hash STREQUAL sha256)
        message(FATAL_ERROR "Native dependency hash mismatch: ${archive_path}")
      endif()
    else()
      message(STATUS "Downloading pinned ${id} source")
      file(DOWNLOAD "${url}" "${archive_path}" EXPECTED_HASH "SHA256=${sha256}"
           TLS_VERIFY ON STATUS download_status TIMEOUT 180)
      list(GET download_status 0 code)
      if(NOT code EQUAL 0)
        message(FATAL_ERROR "Cannot download ${id}: ${download_status}")
      endif()
    endif()
    set(source "${GARAK_DEPENDENCY_SOURCES}/${directory}")
    set(stamp "${source}/.garak-native-source-sha256")
    set(previous "")
    if(EXISTS "${stamp}")
      file(READ "${stamp}" previous)
    endif()
    if(NOT previous STREQUAL sha256)
      set(temporary "${CMAKE_BINARY_DIR}/extract-${id}")
      file(REMOVE_RECURSE "${temporary}")
      file(MAKE_DIRECTORY "${temporary}")
      file(ARCHIVE_EXTRACT INPUT "${archive_path}" DESTINATION "${temporary}")
      if(NOT EXISTS "${temporary}/${archiveRoot}")
        message(FATAL_ERROR "Unexpected root directory in ${archive}")
      endif()
      file(MAKE_DIRECTORY "${source}")
      file(COPY "${temporary}/${archiveRoot}/" DESTINATION "${source}")
      file(WRITE "${stamp}" "${sha256}")
      file(REMOVE_RECURSE "${temporary}")
    endif()
    set(${output} "${source}" PARENT_SCOPE)
    set(found TRUE)
    break()
  endforeach()
  if(NOT found)
    message(FATAL_ERROR "Unpinned native dependency: ${id}")
  endif()
endfunction()
